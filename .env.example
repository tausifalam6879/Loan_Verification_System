# Backend LLM settings. Do not put these keys in React/frontend env files.
# React calls only POST /api/ai/chat; provider calls happen on the backend.

# Local development with Ollama
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_MS=15000

# Public demo/deployment with Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Public demo/deployment with OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Use when LLM_PROVIDER=openai-compatible, for Odysseus or any local /v1 endpoint
LOCAL_LLM_BASE_URL=http://localhost:7000/v1
LOCAL_LLM_API_KEY=

# Authentication delivery. Never commit real provider secrets.
APP_OTP_ENABLED=true
APP_OTP_CONSOLE_FALLBACK_ENABLED=true

# Local SMTP email (works from a local machine; Render Free blocks SMTP ports).
APP_MAIL_ENABLED=false
APP_MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Hosted email over HTTPS (recommended on Render).
# APP_MAIL_PROVIDER=resend
# APP_MAIL_FROM=FinTrack <login@your-verified-domain.com>
RESEND_API_KEY=

# Twilio SMS and WhatsApp over HTTPS.
APP_SMS_ENABLED=false
APP_WHATSAPP_ENABLED=false
APP_SMS_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
